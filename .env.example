# .env.example
DATABASE_URL=
OPENAI_API_KEY=
MEDIA_STORAGE_API_KEY=

# SMTP Email Verification Settings (إعدادات البريد الإلكتروني للتحقق)
# Examples:
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 (Requires App Password)
# Outlook: SMTP_HOST=smtp.office365.com, SMTP_PORT=587
# Custom Webmail: e.g. mail.yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Shouma Explorer" <noreply@shouma-explorer.com>

# Firebase Phone SMS handles authentication on client & app platforms automatically.

# Omani Mall Payment Gateway (بوابة مال العُمانية) - Ready for Activation
MALL_GATEWAY_API_KEY=
MALL_GATEWAY_MERCHANT_ID=
MALL_GATEWAY_SANDBOX_MODE=true
